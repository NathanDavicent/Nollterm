{
  "name": "nollterm",
  "productName": "Nollterm",
  "version": "1.0.0",
  "description": "Kursportal med inbyggd g++: lektioner, frågor, prov och kodlabb.",
  "author": "Nathanael",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "node scripts/copy-web.js && electron .",
    "selftest": "node scripts/selftest.js",
    "dist": "node scripts/copy-web.js && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "se.nollterm.app",
    "productName": "Nollterm",
    "artifactName": "Nollterm-Setup-${version}.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "compiler.js", "web/**/*", "build/icon.png"],
    "extraResources": [{ "from": "vendor/w64devkit", "to": "w64devkit", "filter": ["**/*"] }],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Nollterm"
    }
  }
}
